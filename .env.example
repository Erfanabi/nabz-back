# ---- Database ----
DATABASE_URL="postgresql://nabz:nabz@localhost:5432/nabz?schema=public"

# ---- App ----
NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true
TRUST_PROXY=true

# ---- JWT ----
# در تولید این‌ها را عوض کنید (حداقل ۳۲ کاراکتر تصادفی)
JWT_ACCESS_SECRET=change-me-access-secret-please-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-please-32-chars-min
JWT_ADMIN_SECRET=change-me-admin-secret-please-32-chars-min
FILE_URL_SECRET=change-me-file-signing-secret-32-chars-min
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ---- OTP ----
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_RESEND_AFTER_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
# پاسخ otp/request همیشه حداقل این مدت طول می‌کشد (enumeration resistance)
OTP_REQUEST_MIN_MS=250

# ---- SMS ----
# log | kavenegar | smsir
SMS_DRIVER=log
SMS_SENDER=
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=nabz-otp
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=

# ---- Billing (کارت‌به‌کارت) ----
BILLING_CARD_NUMBER=6037997512345678
BILLING_CARD_HOLDER=شرکت نبض
BILLING_RECEIPT_PHONE=09120000000
BILLING_RECEIPT_CHANNELS=sms,telegram,whatsapp
BILLING_TRIAL_DAYS=30
BILLING_REQUEST_TTL_HOURS=72

# ---- Entitlement ----
ENTITLEMENT_GRACE_DAYS=7
ACCOUNT_DELETION_GRACE_DAYS=7

# ---- App config (/v1/config/app) ----
MIN_SUPPORTED_VERSION=1.0.0
FORCE_UPDATE=false
UPDATE_URL=https://nabz.ir/download
SUPPORT_PHONE=09120000000
SYNC_ENABLED=true

# ---- Storage ----
STORAGE_DIR=./storage
SIGNED_URL_TTL_SECONDS=900
PUBLIC_BASE_URL=http://localhost:3000

# ---- Push ----
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
PUSH_ENABLED=true

# ---- Admin seed ----
ADMIN_SEED_EMAIL=admin@nabz.ir
ADMIN_SEED_PASSWORD=ChangeMe!123
