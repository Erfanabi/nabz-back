// نبض — اسکیمای دیتابیس
// قواعد حاکم:
//  - پول همیشه Int و به تومان (هیچ اعشاری، هیچ ریالی)  → BACKEND-SPEC §۸
//  - updated_at و client_updated_at به صورت epoch ms (BigInt) چون کلاینت با همین مقایسه می‌کند
//  - PAN کامل کارت هیچ‌جا ذخیره نمی‌شود؛ فقط bin و چهار رقم آخر → NFR-10
//  - هیچ عدد مشتقی (spent, summary, goal.status, monthlyNeed) ستون ندارد → BR-02 / P6

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── کاربر و احراز هویت ───────────────────────────────

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  phone                String    @unique @db.VarChar(11)
  displayName          String?   @map("display_name") @db.VarChar(80)
  trialUsed            Boolean   @default(false) @map("trial_used")
  deletionScheduledAt  DateTime? @map("deletion_scheduled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  entitlement   Entitlement?
  queued        QueuedEntitlement[]
  paymentRequests PaymentRequest[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  goals         Goal[]
  recurrings    Recurring[]
  alertReads    AlertRead[]
  settings      UserSettings?
  pushTokens    DevicePushToken[]
  syncOps       SyncOp[]
  changes       ChangeLog[]
  idempotency   IdempotencyKey[]

  @@map("users")
}

// چالش OTP. کد هرگز خام ذخیره نمی‌شود (API-SPEC §۱۰ بند ۲).
model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String    @db.VarChar(11)
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at")
  lockedUntil DateTime? @map("locked_until")
  consumedAt  DateTime? @map("consumed_at")
  deviceId    String?   @map("device_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceId     String    @map("device_id")
  deviceName   String?   @map("device_name")
  platform     String?
  city         String?
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

// refresh token چرخشی. استفادهٔ دوبارهٔ توکن مصرف‌شده = سرقت توکن → باطل کردن همهٔ جلسه‌ها.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         String    @default("admin")
  disabledAt   DateTime? @map("disabled_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  decisions PaymentRequest[] @relation("decided_by")

  @@map("admin_users")
}

// ─────────────────────────────── کاتالوگ پلن ───────────────────────────────

model Plan {
  key           String  @id @db.VarChar(20)
  title         String
  tier          Int
  isPurchasable Boolean @default(false) @map("is_purchasable")
  pitch         String?
  highlights    String[] @default([])
  sortOrder     Int     @default(0) @map("sort_order")

  prices PlanPrice[]

  @@map("plans")
}

model PlanPrice {
  id           Int    @id @default(autoincrement())
  planKey      String @map("plan_key") @db.VarChar(20)
  durationDays Int    @map("duration_days")
  amountToman  Int    @map("amount_toman")

  plan Plan @relation(fields: [planKey], references: [key], onDelete: Cascade)

  @@unique([planKey, durationDays])
  @@map("plan_prices")
}

// سقف‌ها. null = نامحدود، 0 = بسته (API-SPEC §۵.۱).
model PlanLimit {
  key       String  @id @db.VarChar(60)
  label     String
  freeValue Int?    @map("free_value")
  plusValue Int?    @map("plus_value")
  proValue  Int?    @map("pro_value")
  soon      Boolean @default(false)
  sortOrder Int     @default(0) @map("sort_order")

  @@map("plan_limits")
}

model PlanFeature {
  key       String  @id @db.VarChar(60)
  label     String
  freeValue Int     @default(0) @map("free_value")
  plusValue Int     @default(0) @map("plus_value")
  proValue  Int     @default(0) @map("pro_value")
  soon      Boolean @default(false)
  sortOrder Int     @default(0) @map("sort_order")

  @@map("plan_features")
}

// یک ردیف تک با id=1 که نسخهٔ کاتالوگ را نگه می‌دارد (برای بی‌اعتبار کردن کش کلاینت).
model CatalogMeta {
  id        Int      @id @default(1)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("catalog_meta")
}

// ─────────────────────────────── اشتراک ───────────────────────────────

enum EntitlementSource {
  trial
  purchase
  admin_grant
}

model Entitlement {
  userId    String            @id @map("user_id") @db.Uuid
  planKey   String            @map("plan_key") @db.VarChar(20)
  source    EntitlementSource
  startsAt  DateTime          @map("starts_at")
  expiresAt DateTime?         @map("expires_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("entitlements")
}

// پلن‌های خریده‌شده که پشت دورهٔ فعلی صف‌اند (BACKEND-SPEC §۵.۵).
model QueuedEntitlement {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  planKey   String            @map("plan_key") @db.VarChar(20)
  source    EntitlementSource @default(purchase)
  startsAt  DateTime          @map("starts_at")
  expiresAt DateTime          @map("expires_at")
  consumedAt DateTime?        @map("consumed_at")
  createdAt DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@map("queued_entitlements")
}

// ─────────────────────────────── پرداخت ───────────────────────────────

enum PaymentRequestStatus {
  pending
  approved
  rejected
  cancelled
  expired
}

model PaymentRequest {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  planKey      String               @map("plan_key") @db.VarChar(20)
  durationDays Int                  @map("duration_days")
  amountToman  Int                  @map("amount_toman")
  refCode      String               @unique @map("ref_code") @db.VarChar(6)
  provider     String               @default("manual_card")
  status       PaymentRequestStatus  @default(pending)
  expiresAt    DateTime             @map("expires_at")
  decidedAt    DateTime?            @map("decided_at")
  decidedById  String?              @map("decided_by_id") @db.Uuid
  rejectReason String?              @map("reject_reason")
  queued       Boolean?
  startsAt     DateTime?            @map("starts_at")
  endsAt       DateTime?            @map("ends_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy AdminUser?       @relation("decided_by", fields: [decidedById], references: [id])
  receipts  PaymentReceipt[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("payment_requests")
}

// رسید. فقط متن و فایل؛ هیچ PAN کاملی نه در note نه در متادیتا.
model PaymentReceipt {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  channel   String
  note      String?
  filePath  String?  @map("file_path")
  mimeType  String?  @map("mime_type")
  sizeBytes Int?     @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  request PaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("payment_receipts")
}

// ─────────────────────────────── دادهٔ مالی (آینهٔ کلاینت) ───────────────────────────────
// شناسه‌ها را کلاینت می‌سازد (UUID). سرور ID نمی‌سازد → BACKEND-SPEC §۲.۴
// deletedAt برای tombstone، clientUpdatedAt برای last-write-wins.

model Account {
  id         String    @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  icon       String?
  balance    Int       @default(0)
  cardBin    String?   @map("card_bin") @db.VarChar(6)
  cardLast4  String?   @map("card_last4") @db.VarChar(4)
  cardExpiry String?   @map("card_expiry") @db.VarChar(5)
  cardBank   String?   @map("card_bank")
  cardTone   String?   @map("card_tone")
  clientUpdatedAt BigInt   @map("client_updated_at")
  deletedAt  DateTime? @map("deleted_at")
  seq        BigInt    @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  txAccount  Transaction[] @relation("tx_account")
  txFrom     Transaction[] @relation("tx_from")
  txTo       Transaction[] @relation("tx_to")

  @@id([userId, id])
  @@index([userId, seq])
  @@map("accounts")
}

model Category {
  id        String    @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String
  icon      String?
  color     String?
  custom    Boolean   @default(false)
  order     Int       @default(0)
  clientUpdatedAt BigInt @map("client_updated_at")
  deletedAt DateTime? @map("deleted_at")
  seq       BigInt    @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurrings   Recurring[]

  @@id([userId, id])
  @@index([userId, seq])
  @@map("categories")
}

enum TransactionType {
  expense
  income
  transfer
}

// BR-01: انتقال category/account ندارد و درآمد/هزینه from/to ندارد.
// این قاعده با CHECK constraint در migration اجبار می‌شود، نه فقط در کد.
model Transaction {
  id         String          @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  type       TransactionType
  amount     Int
  name       String
  note       String?
  categoryId String?         @map("category_id") @db.Uuid
  accountId  String?         @map("account_id") @db.Uuid
  fromId     String?         @map("from_id") @db.Uuid
  toId       String?         @map("to_id") @db.Uuid
  occurredAt DateTime        @map("occurred_at")
  clientUpdatedAt BigInt     @map("client_updated_at")
  deletedAt  DateTime?       @map("deleted_at")
  seq        BigInt          @default(0)
  createdAt  DateTime        @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [userId, categoryId], references: [userId, id])
  account  Account?  @relation("tx_account", fields: [userId, accountId], references: [userId, id])
  from     Account?  @relation("tx_from", fields: [userId, fromId], references: [userId, id])
  to       Account?  @relation("tx_to", fields: [userId, toId], references: [userId, id])

  @@id([userId, id])
  @@index([userId, seq])
  @@index([userId, occurredAt])
  @@map("transactions")
}

// spent ستون ندارد — مشتق است (BR-02).
model Budget {
  id         String    @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  categoryId String    @map("category_id") @db.Uuid
  limit      Int
  clientUpdatedAt BigInt @map("client_updated_at")
  deletedAt  DateTime? @map("deleted_at")
  seq        BigInt    @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [userId, categoryId], references: [userId, id])

  @@id([userId, id])
  @@index([userId, seq])
  @@map("budgets")
}

// monthlyNeed و status ستون ندارند — مشتق‌اند (BR-02).
model Goal {
  id        String    @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String
  target    Int
  current   Int       @default(0)
  months    Int?
  deadline  DateTime?
  clientUpdatedAt BigInt @map("client_updated_at")
  deletedAt DateTime? @map("deleted_at")
  seq       BigInt    @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, seq])
  @@map("goals")
}

model Recurring {
  id         String          @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  type       TransactionType
  amount     Int
  name       String
  categoryId String?         @map("category_id") @db.Uuid
  accountId  String?         @map("account_id") @db.Uuid
  dayOfMonth Int?            @map("day_of_month")
  everyMonths Int?           @map("every_months")
  nextDueAt  DateTime?       @map("next_due_at")
  active     Boolean         @default(true)
  clientUpdatedAt BigInt     @map("client_updated_at")
  deletedAt  DateTime?       @map("deleted_at")
  seq        BigInt          @default(0)
  createdAt  DateTime        @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [userId, categoryId], references: [userId, id])

  @@id([userId, id])
  @@index([userId, seq])
  @@map("recurrings")
}

// هشدارها محلی تولید می‌شوند؛ سرور فقط پرچم «خوانده شد» را همگام می‌کند.
model AlertRead {
  userId    String    @map("user_id") @db.Uuid
  alertId   String    @map("alert_id")
  deletedAt DateTime? @map("deleted_at")
  seq       BigInt    @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, alertId])
  @@index([userId, seq])
  @@map("alert_reads")
}

// ─────────────────────────────── تنظیمات و دستگاه ───────────────────────────────
// appLock و biometric عمداً اینجا نیستند — تنظیم امنیتیِ همان دستگاه‌اند و به سرور نمی‌روند.

model UserSettings {
  userId        String   @id @map("user_id") @db.Uuid
  calendar      String   @default("jalali")
  digits        String   @default("fa")
  weekStart     String   @default("sat") @map("week_start")
  reportChart   String   @default("bars") @map("report_chart")
  reportStory   Boolean  @default(false) @map("report_story")
  homeSections  Json     @default("{\"goals\":false,\"chart\":false,\"insights\":false}") @map("home_sections")
  autoLock      Int      @default(60) @map("auto_lock")
  benchmarking  Boolean  @default(false)
  localOnly     Boolean  @default(false) @map("local_only")
  alerts        Json     @default("{\"budgetNear\":true,\"budgetOver\":true,\"spendingSpike\":true,\"recurringDue\":true,\"balanceDrop\":true,\"goalBehind\":true,\"savingRateDown\":false}")
  quietHours    Boolean  @default(true) @map("quiet_hours")
  quietFrom     String   @default("22:00") @map("quiet_from") @db.VarChar(5)
  quietTo       String   @default("08:00") @map("quiet_to") @db.VarChar(5)
  timezone      String   @default("Asia/Tehran")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model DevicePushToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceId   String   @map("device_id")
  platform   String
  token      String
  appVersion String?  @map("app_version")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("device_push_tokens")
}

// ─────────────────────────────── همگام‌سازی ───────────────────────────────

enum SyncOpStatus {
  applied
  duplicate
  rejected
  conflict
}

// idempotency روی op_id (API-SPEC §۶.۲ بند ۱). نتیجه ذخیره می‌شود تا تکرار
// همان دسته دقیقاً همان پاسخ را بگیرد.
model SyncOp {
  userId    String       @map("user_id") @db.Uuid
  opId      String       @map("op_id")
  entity    String
  action    String
  status    SyncOpStatus
  result    Json?
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, opId])
  @@map("sync_ops")
}

// منبع sync_cursor. هر تغییر روی دادهٔ کاربر یک ردیف اینجا می‌سازد و شمارندهٔ
// seq همان موجودیت را به‌روز می‌کند.
model ChangeLog {
  seq       BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  entity    String
  entityId  String   @map("entity_id")
  action    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seq])
  @@map("change_log")
}

// ─────────────────────────────── زیرساخت ───────────────────────────────

// Idempotency-Key روی POSTهای نوشتنی (API-SPEC §۲.۶).
model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  key          String
  userId       String?  @map("user_id") @db.Uuid
  route        String
  requestHash  String   @map("request_hash")
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, route, userId])
  @@map("idempotency_keys")
}

// rate limit بدون Redis: پنجرهٔ ثابت با UPSERT اتمیک روی Postgres.
model RateLimitCounter {
  bucket      String   @id
  windowStart DateTime @map("window_start")
  count       Int      @default(0)
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("rate_limit_counters")
}

// کارهای پس‌زمینه‌ای که باید دقیقاً یک‌بار اجرا شوند (حذف حساب، انقضای درخواست).
model JobLock {
  name      String   @id
  lockedAt  DateTime @map("locked_at")
  expiresAt DateTime @map("expires_at")

  @@map("job_locks")
}
